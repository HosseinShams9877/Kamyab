{
  "name": "kamyab-operations-system",
  "version": "0.1.0",
  "private": true,
  "description": "Operations-management system for Kamyab Legal Registration Institute",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:dev:push": "node scripts/prisma-dev.mjs push",
    "db:dev:studio": "node scripts/prisma-dev.mjs studio",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/client": "^6",
    "@tanstack/react-query": "^5",
    "clsx": "^2",
    "jalaali-js": "^1.2",
    "next": "^15",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7",
    "@hookform/resolvers": "^3",
    "tailwind-merge": "^2",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "postcss": "^8",
    "prettier": "^3",
    "prisma": "^6",
    "tailwindcss": "^3.4",
    "typescript": "^5",
    "vitest": "^2"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
