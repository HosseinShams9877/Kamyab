# Copy this file to .env and fill in real values.
#
# --- Development (SQLite, no server to install) ---
# Prisma resolves this path relative to the prisma/ directory (=> prisma/dev.db).
DATABASE_URL="file:./dev.db"
#
# --- Production (PostgreSQL) ---
# In production, replace DATABASE_URL with a PostgreSQL connection string, e.g.:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/kamyab?schema=public"

# Secret used to sign sessions. Use a long, random, unique value per environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"
